# PostgreSQL
POSTGRES_USER=bcb_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=bcb_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API do Banco Central (SGS) - geralmente não exige chave, mas deixamos preparado
BCB_API_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# Resumo diário com IA (opcional). Chave criada no Google AI Studio.
# Sem a chave, o resumo é gerado por regras, sem IA.
LLM_API_KEY=
# Modelo do Gemini (opcional). Padrão: gemini-3.5-flash-lite
# LLM_MODEL=gemini-3.5-flash-lite
